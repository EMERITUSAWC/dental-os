# Settings for Dental OS on the clinic's own computer. install-ubuntu.sh copies this to /etc/dental-os.env and fills in
# SECRET_KEY. Only root and the dentalos user can read that file. Never send it by WhatsApp or email.
FLASK_APP=dental_os
SECRET_KEY=
DATABASE_PATH=/var/lib/dental-os/dental.sqlite
FILES_PATH=/var/lib/dental-os/files
# The address staff type in. Behind Caddy on the clinic network, for example https://dental.local
PUBLIC_URL=
COOKIE_SECURE=1
TRUST_PROXY=1
# Off-site copies: a USB disk folder or an https WebDAV address, and a long passphrase kept on paper away from the computer.
OFFSITE_TARGET=
OFFSITE_PASSPHRASE=
OFFSITE_USER=
OFFSITE_PASSWORD=
# 0.67: who to tell about a security problem, published at /.well-known/security.txt. For example mailto:security@yourclinic.com
SECURITY_CONTACT=
# Changing SECRET_KEY later makes older activity seals uncheckable. Run `dos audit-verify` and keep an evidence pack first.
# 0.71: the company's HQ on its own address (leave empty to keep HQ at /hq on the main address)
HQ_HOST=
# 0.72: a clinic's own server reports its health to HQ (from HQ, Engineering: make an install key)
HQ_URL=
HQ_INSTALL_KEY=
