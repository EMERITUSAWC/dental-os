#!/bin/sh
# Runs a Dental OS command with the server's settings, as the dentalos user. Used by the scheduled jobs.
#   dos doctor        dos offsite-drill        dos create-user
# The settings file is read line by line, the way systemd reads it, so a passphrase with spaces works unquoted.
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in ''|'#'*) continue ;; esac
  case "$line" in *=*) export "$line" ;; esac
done < /etc/dental-os.env
cd /opt/dental-os || exit 1
exec /opt/dental-os/venv/bin/flask "$@"
